# Only clients on the internal 192.168.1.0/24 network may access it.
#
# rw
#   Allows clients to read and write files.
#
# sync
#   Ensures write operations are committed synchronously for reliability.
#
# no_subtree_check
#   Avoids subtree verification issues when exporting this directory.

/home/adam/shared 192.168.1.0/24(rw,sync,no_subtree_check)
