// Local authoritative DNS zones for Assignment 2.

// Forward zone for the student-specific domain.
// Maps hostnames such as server.student75872.lan to IPv4 addresses.
zone "student75872.lan" {
    type master;
    file "/etc/bind/db.student75872.lan";
};

// Reverse zone for the 192.168.1.0/24 internal network.
// Maps IPv4 addresses back to hostnames using PTR records.
zone "1.168.192.in-addr.arpa" {
    type master;
    file "/etc/bind/db.192.168.1";
};
